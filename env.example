# V2VBot Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# GPU Configuration
# ============================================
# Enable GPU acceleration (auto-detects if available)
USE_GPU=true

# Specify which GPU to use (0 for first GPU)
CUDA_VISIBLE_DEVICES=0

# ============================================
# API Keys
# ============================================
# Google Gemini API Key (required)
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# Model Configuration
# ============================================
# Gemini model to use
# Options: gemini-2.0-flash (recommended), gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash

# Whisper STT model size (for latency optimization)
# Options: tiny.en (fastest, ~0.3s), base.en (fast, ~0.6s), small.en (balanced, ~1.3s), medium.en (accurate, ~2s)
# For real-time conversation, use tiny.en or base.en
WHISPER_MODEL=small.en

# ============================================
# Text-to-Speech (TTS) Configuration
# ============================================
# TTS is now local MeloTTS (GPU-accelerated)
# TTS device is auto-detected based on USE_GPU setting
# No TTS_URL needed - TTS runs locally with GPU support

# ============================================
# Voice Activity Detection (VAD) Settings
# ============================================
# VAD threshold (0.0 to 1.0, higher = more strict)
VAD_THRESHOLD=0.5

# Window size in milliseconds for VAD processing
VAD_WINDOW_MS=20

# Short pause detection (milliseconds) - end of utterance
# Lower values = faster response but may cut off slow speakers
# Optimized: 700ms for real-time conversation (balance of speed vs accuracy)
VAD_END_MS=700

# Long pause detection (milliseconds) - end of turn
VAD_TURN_END_MS=2000

# Fallback energy threshold if VAD model fails
VAD_ENERGY_FALLBACK=0.05

# ============================================
# Server Configuration
# ============================================
# Server host and port
HOST=0.0.0.0
PORT=8080

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

