# Multi-stage Dockerfile - V2VBot Voice Assistant (CUDA runtime image)
FROM nvidia/cuda:12.2.0-runtime-ubuntu22.04 as builder

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1

# Install system dependencies for building
RUN apt-get update && apt-get install -y \
    curl wget git ca-certificates gnupg lsb-release \
    software-properties-common \
    build-essential \
    python3.11 python3.11-venv python3.11-dev \
    pkg-config \
  && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install pip for Python 3.11
RUN curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11

# Create symlinks for python3 and pip3
RUN ln -sf /usr/bin/python3.11 /usr/bin/python3 && \
    ln -sf /usr/bin/python3.11 /usr/bin/python && \
    ln -sf /usr/local/bin/pip3.11 /usr/bin/pip3 && \
    ln -sf /usr/local/bin/pip3.11 /usr/bin/pip

# Copy requirements and install Python dependencies
COPY server/requirements.txt /tmp/requirements.txt
RUN python3 -m pip install --upgrade pip setuptools wheel
RUN python3 -m pip install --no-cache-dir -r /tmp/requirements.txt

# Install MeloTTS from GitHub (not available on PyPI)
RUN python3 -m pip install --no-cache-dir git+https://github.com/myshell-ai/MeloTTS.git

# Final stage - runtime image
FROM nvidia/cuda:12.2.0-runtime-ubuntu22.04

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:$PATH \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH \
    USE_GPU=true \
    CUDA_VISIBLE_DEVICES=0

# Install only runtime dependencies
RUN apt-get update && apt-get install -y \
    curl wget \
    ffmpeg \
    libsndfile1 libsndfile1-dev \
    libopus0 libopus-dev \
    portaudio19-dev libportaudio2 \
    socat net-tools iproute2 tzdata procps \
    coturn \
    python3.11 python3.11-venv \
  && apt-get clean && rm -rf /var/lib/apt/lists/*

# Copy Python installation from builder stage
COPY --from=builder /usr/local/lib/python3.11 /usr/local/lib/python3.11
COPY --from=builder /usr/local/bin /usr/local/bin
COPY --from=builder /usr/bin/python3.11 /usr/bin/python3.11
COPY --from=builder /usr/bin/python3 /usr/bin/python3
COPY --from=builder /usr/bin/python /usr/bin/python

# Create app user
RUN useradd -m appuser
WORKDIR /home/appuser

# Copy application code
COPY server/ /home/appuser/server/
COPY web/ /home/appuser/web/

# Create necessary directories (models will be downloaded during server setup)
RUN mkdir -p /home/appuser/logs /home/appuser/debug_audio /home/appuser/models

# Copy start script
COPY start_docker.sh /home/appuser/start.sh

# Set ownership and permissions
RUN chown -R appuser:appuser /home/appuser
RUN chmod +x /home/appuser/start.sh

WORKDIR /home/appuser

# Expose ports
# 8080: Main V2VBot application
# 3478/tcp 3478/udp: TURN server for WebRTC
# 5349/tcp: TURNS server (TLS)
# 50000-50050/udp: TURN relay ports
EXPOSE 8080/tcp 3478/tcp 3478/udp 5349/tcp 50000-50050/udp

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/ || exit 1

USER appuser

ENTRYPOINT ["/home/appuser/start.sh"]
